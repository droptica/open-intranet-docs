---
// Audience badge with an explanation on hover and keyboard focus.
// Pages without a badge are for every logged-in user.
import { Badge } from '@astrojs/starlight/components';

interface Props {
	level: 'editors' | 'administrators' | 'optional';
}

const levels = {
	editors: {
		text: 'Editors',
		variant: 'note',
		tip: 'For people with an editor role, for example Content editor. If you cannot see these options, ask your administrator.',
	},
	administrators: {
		text: 'Administrators',
		variant: 'caution',
		tip: 'For administrators only.',
	},
	optional: {
		text: 'Optional feature',
		variant: 'default',
		tip: 'Only available if your administrator has enabled this feature.',
	},
} as const;

const { text, variant, tip } = levels[Astro.props.level];
---

<span class="audience" tabindex="0" role="note" data-tip={tip} aria-label={`${text}: ${tip}`}>
	<Badge text={text} variant={variant} />
</span>

<style>
	.audience {
		position: relative;
		display: inline-block;
		cursor: help;
	}

	.audience::after {
		content: attr(data-tip);
		position: absolute;
		inset-inline-start: 0;
		top: calc(100% + 0.4rem);
		z-index: 50;
		width: max-content;
		max-width: min(18rem, 80vw);
		padding: 0.5rem 0.7rem;
		border-radius: 0.4rem;
		background: var(--sl-color-white);
		color: var(--sl-color-black);
		box-shadow: var(--sl-shadow-md);
		font-size: var(--sl-text-sm);
		font-weight: 400;
		line-height: 1.4;
		text-align: start;
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
	}

	.audience:hover::after,
	.audience:focus::after {
		opacity: 1;
		visibility: visible;
	}
</style>
