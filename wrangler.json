{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "open-intranet-docs",
	"account_id": "f1be21e4d3549cc744b8381c380eb0af",
	"main": "src/worker.js",
	"compatibility_date": "2025-09-27",
	"routes": [
		{
			"pattern": "www.open-intranet.com/docs",
			"zone_name": "open-intranet.com"
		},
		{
			"pattern": "www.open-intranet.com/docs/*",
			"zone_name": "open-intranet.com"
		}
	],
	"assets": {
		"directory": "dist",
		"binding": "ASSETS",
		"run_worker_first": true,
		"html_handling": "force-trailing-slash",
		"not_found_handling": "404-page"
	}
}
